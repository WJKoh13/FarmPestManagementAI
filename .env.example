# Example environment overrides. Copy to .env and edit; .env is Git-ignored.
#
# Any configuration key can be overridden with an FPA__-prefixed variable,
# where a double underscore separates nesting levels. Environment variables
# take precedence over YAML files but lose to CLI --set flags.

# --- Project location -------------------------------------------------
# Overrides project-root detection. Usually unnecessary on the host; set
# inside a container where the checkout lives at a fixed path.
# FPA_PROJECT_ROOT=/workspace

# --- Dataset ----------------------------------------------------------
# Active classification scope: rice10 or full102.
# FPA__DATASET__SCOPE=rice10

# Point at the dataset if it is not at <project_root>/ip102_v1.1.
# On Windows use forward slashes or escaped backslashes.
# FPA__PATHS__DATASET_ROOT=/data/ip102_v1.1

# --- Runtime ----------------------------------------------------------
# FPA__RUNTIME__DEVICE=auto
# FPA__RUNTIME__NUM_WORKERS=8
# FPA__RUNTIME__AMP=true

# --- Reproducibility --------------------------------------------------
# FPA__REPRODUCIBILITY__SEED=1337

# --- Logging ----------------------------------------------------------
# Console threshold; takes precedence over --log-level.
# FPA_LOG_LEVEL=INFO

# --- Application ---------------------------------------
# FPA__API__PORT=8000
# FPA__FRONTEND__API_BASE_URL=http://api:8000

# Internal service address; never publish Ollama to the host.
# FPA__LLM__BASE_URL=http://ollama:11434
# FPA__LLM__ENABLED=true
